import numpy as np
import matplotlib.pyplot as plt

#%%
class DesertDP:
    def __init__(self, max_days, capacity_water, capacity_food):
        self.D = max_days
        self.W = capacity_water
        self.F = capacity_food
        self.weather = [0,1,0,1,0,1,0]
        self.consume_w = [2,3]
        self.consume_f = [1,2]

    def solve(self):
        dp = np.full((self.D+1, self.W+1, self.F+1), -1.0)
        dp[0, self.W, self.F] = 1.0
        for day in range(self.D):
            wth = self.weather[day % len(self.weather)]
            cw = self.consume_w[wth]
            cf = self.consume_f[wth]
            for w in range(self.W+1):
                for f in range(self.F+1):
                    if dp[day,w,f] < 0: continue
                    nw = w - cw
                    nf = f - cf
                    if nw >=0 and nf >=0:
                        dp[day+1, nw, nf] = max(dp[day+1, nw, nf], dp[day,w,f])
        return np.max(dp[self.D])

#%%
solver = DesertDP(7,12,12)
survival = solver.solve()
print("DP Survival Probability:", survival)

#%%
class GameNash:
    def __init__(self, payoff_matrix):
        self.payoff = payoff_matrix

    def equilibrium(self):
        n, m = self.payoff.shape
        br1 = np.argmax(self.payoff, axis=1)
        br2 = np.argmax(self.payoff, axis=0)
        eq = []
        for i in range(n):
            j = br1[i]
            if br2[j] == i:
                eq.append((i,j))
        return eq

#%%
payoff = np.array([
    [5,1],
    [2,4]
])
game = GameNash(payoff)
ne = game.equilibrium()
print("Nash Equilibria:", ne)

