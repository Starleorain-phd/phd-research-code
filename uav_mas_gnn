#%%
class GATLayer(nn.Module):
    def __init__(self, in_dim, out_dim):
        super().__init__()
        self.W = nn.Linear(in_dim, out_dim)
        self.a = nn.Linear(2*out_dim, 1)
        self.relu = nn.LeakyReLU(0.2)

    def forward(self, h, adj):
        Wh = self.W(h)
        N = Wh.shape[0]
        a_input = torch.cat([Wh.unsqueeze(1).repeat(1,N,1), Wh.unsqueeze(0).repeat(N,1,1)], dim=2)
        e = self.relu(self.a(a_input)).squeeze(-1)
        mask = adj == 0
        e[mask] = -1e9
        att = torch.softmax(e, dim=1)
        h_prime = torch.matmul(att, Wh)
        return h_prime

#%%
class MultiAgentSystem:
    def __init__(self, n_agents, n_nodes):
        self.n = n_agents
        self.tour = np.zeros((n_agents, n_nodes), dtype=bool)

    def allocate(self, cost_matrix):
        assignment = np.zeros_like(cost_matrix)
        for i in range(self.n):
            best = np.argmin(cost_matrix[i])
            assignment[i, best] =1
        return assignment

