class UAVRoutingEnv:
    def __init__(self, loc, no_fly_zone):
        self.loc = loc
        self.nfz = no_fly_zone

    def reward(self, path):
        dist = 0
        valid = True
        for i in range(len(path)-1):
            dist += np.linalg.norm(loc[path[i]] - loc[path[i+1]])
            if path[i] in self.nfz:
                valid = False
        return -dist if valid else -1000

env = UAVRoutingEnv(loc, [3,7,12])
path = [0,2,5,9,15]
print("Reward:", env.reward(path))
